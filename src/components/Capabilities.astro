---
/**
 * Capabilities.astro — "Spec Sheet" redesign
 *
 * Replaces the 4 capability cards with an engineering spec table + a
 * dimensional-tolerance window, alongside the industries list.
 * Same steel/laser tokens and fonts as the rest of the site.
 */
interface Props {
  lang?: 'en' | 'zh';
}
const { lang = 'en' } = Astro.props;

const content = {
  en: {
    eyebrow: 'Technical Specification',
    index: '[ 02 ]',
    title1: 'Tolerances we hold',
    titleAccent: 'to standard',
    qa: 'QA · 100% INSPECTION',
    rows: [
      { k: 'Standard Tolerance', v: '±0.05', u: ' mm' },
      { k: 'Min. Character Height', v: '0.1', u: ' mm' },
      { k: 'Processes', v: 'CNC · Laser', u: '' },
      { k: 'Hardened Steel', v: '60', u: ' HRC' },
      { k: 'Inspection Rate', v: '100%', u: '' },
      { k: 'Materials', v: 'Stavax · D2 · Cu', u: '' },
    ],
    windowLabel: 'Dimensional Window',
    note: 'Standard tolerance of ±0.05mm for interchangeable mold inserts and precision dies, verified on every part.',
    industriesLabel: 'Industries Served',
    guaranteeLabel: 'Quality Guarantee',
    guarantees: [
      { v: '100%', k: 'Inspection' },
      { v: 'Zero', k: 'Defects' },
      { v: 'Secure', k: 'IP Protected' },
      { v: '40+', k: 'Years · Since 1984' },
    ],
  },
  zh: {
    eyebrow: '技术规格',
    index: '[ 02 ]',
    title1: '我们严守的',
    titleAccent: '公差标准',
    qa: '质检 · 100% 检验',
    rows: [
      { k: '标准公差', v: '±0.05', u: ' mm' },
      { k: '最小字符高度', v: '0.1', u: ' mm' },
      { k: '加工方式', v: 'CNC · 激光', u: '' },
      { k: '硬化钢', v: '60', u: ' HRC' },
      { k: '检验率', v: '100%', u: '' },
      { k: '材料', v: 'Stavax · D2 · 铜', u: '' },
    ],
    windowLabel: '尺寸公差范围',
    note: '可互换模具镶件与精密模具的标准公差为 ±0.05mm，每件产品均经检验。',
    industriesLabel: '服务行业',
    guaranteeLabel: '质量保证',
    guarantees: [
      { v: '100%', k: '检验' },
      { v: '零', k: '缺陷' },
      { v: '保密', k: '知识产权保护' },
      { v: '40+', k: '年 · 始于 1984' },
    ],
  },
}[lang];

const industries = lang === 'zh'
  ? ['注塑成型', '压铸', '医疗器械', '航空航天', '汽车', '包装', '消费品']
  : ['Injection Molding', 'Die Casting', 'Medical Devices', 'Aerospace', 'Automotive', 'Packaging', 'Consumer Goods'];
---

<section id="capabilities" class="py-16 md:py-24 lg:py-32 relative bg-steel-900/30">
  <div class="absolute top-0 left-0 right-0 h-[1px] bg-gradient-to-r from-transparent via-steel-700 to-transparent"></div>

  <div class="max-w-7xl mx-auto px-6 lg:px-8 relative">

    <!-- Section header -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10 md:mb-14 reveal">
      <div>
        <div class="font-mono text-[11px] tracking-[0.28em] text-steel-400 uppercase mb-3.5"><span class="text-laser">{content.index}</span> — {content.eyebrow}</div>
        <h2 class="font-display text-3xl md:text-5xl font-bold tracking-tight text-white">
          {content.title1} <span class="text-laser">{content.titleAccent}</span>
        </h2>
      </div>
      <div class="font-mono text-[11px] tracking-[0.14em] text-steel-400">{content.qa}</div>
    </div>

    <div class="grid lg:grid-cols-[1.15fr_0.85fr] gap-8 lg:gap-12 items-stretch">

      <!-- Spec table -->
      <table class="w-full border border-steel-800 border-collapse">
        <tbody>
          {content.rows.map((r) => (
            <tr class="border-b border-steel-800 last:border-b-0 hover:bg-steel-900/40 transition-colors">
              <td class="font-mono text-[11px] tracking-[0.1em] uppercase text-steel-300 w-[46%] border-r border-steel-800 px-4 py-4 align-middle">{r.k}</td>
              <td class="font-display font-semibold text-white text-lg md:text-xl px-4 py-4 align-middle">{r.v}<span class="text-laser">{r.u}</span></td>
            </tr>
          ))}
        </tbody>
      </table>

      <!-- Dimensional window + industries -->
      <div class="flex flex-col h-full">
        <div class="border border-steel-800 bg-steel-900/40 p-6">
          <div class="flex items-center justify-between mb-5">
            <span class="font-mono text-[10.5px] tracking-[0.2em] uppercase text-steel-400">{content.windowLabel}</span>
            <span class="font-mono text-[11px] text-laser border border-laser px-2.5 py-1">±0.05mm</span>
          </div>
          <div class="relative h-20 border border-steel-700 bg-steel-950 overflow-hidden">
            <div class="absolute inset-0 flex">
              {[...Array(11)].map((_, i) => (
                <div class={`flex-1 ${i < 10 ? 'border-r' : ''} ${i % 5 === 0 ? 'border-steel-700' : 'border-steel-800/60'} relative`}>
                  {i % 5 === 0 && (
                    <span class="absolute bottom-1 left-1/2 -translate-x-1/2 font-mono text-[8px] text-steel-500">{((i - 5) * 0.02).toFixed(2)}</span>
                  )}
                </div>
              ))}
            </div>
            <div class="absolute top-[18px] bottom-6 left-[45%] w-[10%] bg-laser/20 border-l-[1.5px] border-r-[1.5px] border-laser"></div>
            <div class="absolute top-0 bottom-0 left-1/2 w-[1.5px] bg-precision-cyan -translate-x-1/2"></div>
          </div>
          <p class="font-body text-sm text-steel-400 mt-4">{content.note}</p>
        </div>

        <div class="mt-6 lg:mt-auto lg:pt-8">
          <div class="font-mono text-[10.5px] tracking-[0.2em] uppercase text-steel-400 mb-3.5">{content.industriesLabel}</div>
          <div class="flex flex-wrap gap-2">
            {industries.map((industry) => (
              <span class="font-mono text-[11px] text-steel-200 border border-steel-700 px-3 py-1.5 hover:border-laser/60 hover:text-white transition-colors">{industry}</span>
            ))}
          </div>
        </div>
      </div>

    </div>

    <!-- Quality guarantee strip (folded in from the former Precision section) -->
    <div class="mt-10 md:mt-14 reveal">
      <div class="font-mono text-[10.5px] tracking-[0.2em] uppercase text-steel-400 mb-3.5">{content.guaranteeLabel}</div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-steel-800 border border-steel-800">
        {content.guarantees.map((g) => (
          <div class="bg-steel-950 px-4 py-5 hover:bg-steel-900/40 transition-colors">
            <div class="font-display font-bold text-white text-xl md:text-2xl leading-none">{g.v}</div>
            <div class="font-mono text-[10.5px] tracking-[0.12em] text-steel-400 uppercase mt-2">{g.k}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
