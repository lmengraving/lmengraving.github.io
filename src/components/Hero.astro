---
/**
 * Hero.astro — "Spec Sheet" redesign
 *
 * Two-column hero: headline + stat readout on the left, an annotated
 * "engineering drawing" photo plate on the right (corner ticks, tolerance
 * tags, FIG.01 callout, meta row). Uses the existing steel/laser tokens,
 * Oswald/Barlow/JetBrains Mono, and the project's animate-fade-up entrance.
 *
 * Image: /public/laser-engraved-mold-cavity.jpeg (already in the repo).
 */
interface Props {
  lang?: 'en' | 'zh';
}
const { lang = 'en' } = Astro.props;

const t = {
  en: {
    eyebrow: 'Since 1984 · Singapore',
    title1: 'Precision engraving,',
    title2: 'down to the',
    titleAccent: 'last micron.',
    sub: "Four decades of laser mold engraving, marking dies, EDM electrodes and 3D surfacing — built to ±0.05\u00A0mm for the world's most demanding tooling.",
    ctaQuote: 'Request a Quote',
    ctaServices: 'View Capabilities',
    stats: [
      { v: '40', u: '+', k: 'Years' },
      { v: '±0.05', u: 'mm', k: 'Tolerance' },
      { v: '5', u: '-Axis', k: 'Laser' },
      { v: '100', u: '%', k: 'Inspected' },
    ],
    fig: 'FIG.01 — MOLD CAVITY / 2083 ESR · 50–52 HRC',
    tol: 'TOL ±0.05mm',
    axis: '5-AXIS LASER',
  },
  zh: {
    eyebrow: '始于 1984 · 新加坡',
    title1: '精密雕刻，',
    title2: '精确至',
    titleAccent: '微米级。',
    sub: '四十年激光模具雕刻、打标模具、EDM 电极及 3D 曲面雕刻经验 —— 公差控制在 ±0.05\u00A0毫米，满足最严苛的模具需求。',
    ctaQuote: '获取报价',
    ctaServices: '查看能力',
    stats: [
      { v: '40', u: '+', k: '年经验' },
      { v: '±0.05', u: 'mm', k: '公差' },
      { v: '5', u: '轴', k: '激光' },
      { v: '100', u: '%', k: '检验' },
    ],
    fig: 'FIG.01 — 模腔 / 2083 ESR · 50–52 HRC',
    tol: '公差 ±0.05mm',
    axis: '五轴激光',
  },
}[lang];
---

<section class="relative min-h-screen flex items-center pt-32 lg:pt-36 pb-16 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 w-full relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- Left: headline + readout -->
      <div>
        <div class="inline-flex items-center gap-3 mb-6 opacity-0 animate-fade-up">
          <span class="w-12 h-[1px] bg-laser"></span>
          <span class="font-mono text-xs tracking-[0.28em] text-laser uppercase">{t.eyebrow}</span>
        </div>

        <h1 class="font-display font-bold text-white text-5xl md:text-6xl lg:text-7xl leading-[0.98] tracking-tight mb-6 opacity-0 animate-fade-up delay-100">
          {t.title1}<br />{t.title2} <span class="text-laser">{t.titleAccent}</span>
        </h1>

        <p class="font-body text-lg text-steel-300 max-w-xl mb-9 leading-relaxed opacity-0 animate-fade-up delay-200">
          {t.sub}
        </p>

        <div class="flex flex-col sm:flex-row gap-4 mb-10 opacity-0 animate-fade-up delay-300">
          <a href="#quote" class="group inline-flex items-center justify-center gap-3 px-7 py-4 bg-laser text-white font-mono text-xs tracking-[0.16em] uppercase hover:bg-laser-glow transition-colors">
            {t.ctaQuote}
            <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
          <a href="#capabilities" class="inline-flex items-center justify-center gap-3 px-7 py-4 border border-steel-600 text-steel-200 font-mono text-xs tracking-[0.16em] uppercase hover:border-laser hover:text-white transition-colors">
            {t.ctaServices}
          </a>
        </div>

        <!-- Stat readout table -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-px bg-steel-800 border border-steel-800 opacity-0 animate-fade-up delay-400">
          {t.stats.map((s) => (
            <div class="bg-steel-950 px-4 py-4">
              <div class="font-display font-bold text-white text-2xl lg:text-3xl leading-none">{s.v}<span class="text-laser">{s.u}</span></div>
              <div class="font-mono text-[9.5px] tracking-[0.12em] text-steel-500 uppercase mt-1.5">{s.k}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: annotated photo plate -->
      <div class="relative border border-steel-700 bg-steel-900/40 p-3.5 opacity-0 animate-fade-up delay-200">
        <!-- top-left annotation -->
        <div class="absolute -left-px -top-px z-[4] font-mono text-[10px] text-precision-cyan bg-steel-950 border border-steel-700 px-2 py-1">{t.fig}</div>

        <div class="relative overflow-hidden bg-black aspect-square">
          <span class="absolute top-1.5 left-1.5 w-[18px] h-[18px] border-l-[1.5px] border-t-[1.5px] border-laser z-[3]"></span>
          <span class="absolute top-1.5 right-1.5 w-[18px] h-[18px] border-r-[1.5px] border-t-[1.5px] border-laser z-[3]"></span>
          <span class="absolute bottom-1.5 left-1.5 w-[18px] h-[18px] border-l-[1.5px] border-b-[1.5px] border-laser z-[3]"></span>
          <span class="absolute bottom-1.5 right-1.5 w-[18px] h-[18px] border-r-[1.5px] border-b-[1.5px] border-laser z-[3]"></span>
          <img src="/laser-engraved-mold-cavity.jpeg" alt="Laser-engraved injection mold cavity" class="w-full h-full object-cover" loading="eager" />
        </div>

        <!-- floating tags -->
        <span class="absolute top-[30px] right-0 z-[4] font-mono text-[10px] text-steel-300 bg-steel-950 border border-steel-700 px-2.5 py-1.5"><span class="text-laser">◇</span> {t.tol}</span>
        <span class="absolute bottom-[30px] left-0 z-[4] font-mono text-[10px] text-steel-300 bg-steel-950 border border-steel-700 px-2.5 py-1.5"><span class="text-laser">◇</span> {t.axis}</span>

        <!-- meta row -->
        <div class="flex justify-between items-center mt-3 font-mono text-[10px] tracking-wider text-steel-500">
          <span>SRC <span class="text-steel-300">/cavity-101</span></span>
          <span>SCALE 1:1</span>
          <span class="text-steel-300">L M PRECISION</span>
        </div>
      </div>

    </div>
  </div>
</section>
